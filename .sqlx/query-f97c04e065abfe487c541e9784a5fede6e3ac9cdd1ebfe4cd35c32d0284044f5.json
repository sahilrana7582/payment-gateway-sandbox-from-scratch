{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE jobs\n        SET state = 'running',\n            locked_at = $3,\n            locked_by = $1,\n            attempts = attempts + 1,\n            updated_at = $3\n        WHERE id IN (\n            SELECT id FROM jobs\n            WHERE state = 'pending' AND run_at <= $3\n            ORDER BY run_at\n            FOR UPDATE SKIP LOCKED\n            LIMIT $2\n        )\n        RETURNING id, kind, payload, state AS \"state: JobState\",\n                  run_at, attempts, max_attempts, last_error\n        ",
