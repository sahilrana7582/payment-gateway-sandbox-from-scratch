  "query": "\n        SELECT id, merchant_id, type AS \"event_type\", payload, api_version, created_at\n        FROM events\n        WHERE merchant_id = $1\n          AND ($2::timestamptz IS NULL OR created_at < $2)\n        ORDER BY created_at DESC\n        LIMIT $3\n        ",
