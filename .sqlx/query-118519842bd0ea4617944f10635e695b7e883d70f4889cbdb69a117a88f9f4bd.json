{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, merchant_id, amount_minor, currency, amount_paid,\n               receipt, notes, status AS \"status: OrderStatus\", created_at\n        FROM orders\n        WHERE merchant_id = $1\n          AND ($2::timestamptz IS NULL OR created_at < $2)\n        ORDER BY created_at DESC\n        LIMIT $3\n        ",
