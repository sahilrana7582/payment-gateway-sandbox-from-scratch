# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://sandbox:sandbox@localhost:5432/sandbox_dev
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

# Crypto — generate real values with: openssl rand -hex 32
CRYPTO_MASTER_KEY=change_me_32_hex_chars_minimum_here
CRYPTO_CARD_FINGERPRINT_PEPPER=change_me_different_pepper_here

# Observability
RUST_LOG=info,sandbox_server=debug
ENVIRONMENT=development
